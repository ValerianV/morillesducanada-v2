{
  "trailingSlash": false,
  "redirects": [
    { "source": "/pre-commande", "destination": "/precommande-2027", "permanent": false },
    { "source": "/pre-commande/", "destination": "/precommande-2027", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:path(admin|auth|profil|reset-password|paiement-reussi|paiement-annule|precommande-confirmee)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/spa.html" }
  ]
}
