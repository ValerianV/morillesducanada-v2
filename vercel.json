{
  "trailingSlash": false,
  "redirects": [
    { "source": "/pre-commande", "destination": "/precommande-2027", "permanent": false },
    { "source": "/pre-commande/", "destination": "/precommande-2027", "permanent": false },
    { "source": "/produits", "destination": "/professionnels", "permanent": true },
    { "source": "/produits/:path*", "destination": "/professionnels", "permanent": true },
    { "source": "/profil", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/:path(admin|auth|reset-password|paiement-reussi|paiement-annule|precommande-confirmee|journal)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/:path(admin|auth|reset-password|paiement-reussi|paiement-annule|precommande-confirmee|journal)", "destination": "/spa.html" }
  ]
}
